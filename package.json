{
  "name": "@kwtechnologies/kube-shopify",
  "version": "0.0.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --no-config --format cjs --dts --out-dir dist && node ./scripts/normalize-dist.mjs",
    "codegen": "graphql-codegen --config .graphqlrc.ts",
    "release:minor": "node ./scripts/release-minor.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@shopify/admin-api-client": "^1.1.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.0",
    "@shopify/api-codegen-preset": "^1.2.0",
    "@types/node": "^24.3.0",
    "semver": "^7.7.2",
    "tsdown": "^0.21.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}